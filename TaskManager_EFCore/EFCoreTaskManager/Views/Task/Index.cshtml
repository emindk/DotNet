
<h2>Task List</h2>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>CategoryId</th>
            <th>Completed</th>
            <th>Edit ?</th>
            <th>Delete ?</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.Category?.Name</td>
                <td>@(task.IsCompleted ? "✅" : "❌")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-primary">Edit</a>
                </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-primary">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>

<a asp-controller="Task" asp-action="Create" class="btn btn-primary">Add New Task</a>

