@{
    ViewData["Title"] = "Home Page";
}

@model List<TaskManager.Models.TaskItem>

<h2>Task List</h2>
<a href="/Task/Create">Add New Task</a>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Completed</th>
        <th>Actions</th>
    </tr>
    @foreach (var task in Model)
    {
        <tr>
            <td>@task.Id</td>
            <td>@task.Title</td>
            <td>@(task.IsCompleted ? "Yes" : "No")</td>
            <td>
                <a href="/Task/Delete/@task.Id">Delete</a>
            </td>
        </tr>
    }
</table>

